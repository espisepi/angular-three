{
	"name": "sepinaco-proyecto",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"prefix": "app",
	"sourceRoot": "apps/sepinaco-proyecto/src",
	"tags": [],
	"targets": {
		"build": {
			"executor": "@angular/build:application",
			"outputs": ["{options.outputPath}"],
			"defaultConfiguration": "production",
			"options": {
				"outputPath": "dist/apps/sepinaco-proyecto",
				"browser": "apps/sepinaco-proyecto/src/main.ts",
				"tsConfig": "apps/sepinaco-proyecto/tsconfig.app.json",
				"inlineStyleLanguage": "scss",
				"assets": [
					{
						"glob": "**/*",
						"input": "apps/sepinaco-proyecto/public"
					}
				],
				"styles": ["apps/sepinaco-proyecto/src/styles.scss"]
			},
			"configurations": {
				"production": {
					"budgets": [
						{
							"type": "initial",
							"maximumWarning": "500kb",
							"maximumError": "1mb"
						},
						{
							"type": "anyComponentStyle",
							"maximumWarning": "4kb",
							"maximumError": "8kb"
						}
					],
					"outputHashing": "all"
				},
				"development": {
					"optimization": false,
					"extractLicenses": false,
					"sourceMap": true
				}
			}
		},
		"serve": {
			"continuous": true,
			"executor": "@angular/build:dev-server",
			"defaultConfiguration": "development",
			"configurations": {
				"production": {
					"buildTarget": "sepinaco-proyecto:build:production"
				},
				"development": {
					"buildTarget": "sepinaco-proyecto:build:development"
				}
			}
		},
		"lint": {
			"executor": "@nx/eslint:lint"
		},
		"test": {
			"executor": "@nx/jest:jest",
			"outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
			"options": {
				"jestConfig": "apps/sepinaco-proyecto/jest.config.cts",
				"tsConfig": "apps/sepinaco-proyecto/tsconfig.spec.json"
			}
		},
		"serve-static": {
			"continuous": true,
			"executor": "@nx/web:file-server",
			"options": {
				"buildTarget": "sepinaco-proyecto:build",
				"staticFilePath": "dist/apps/sepinaco-proyecto/browser",
				"spa": true
			}
		}
	}
}
