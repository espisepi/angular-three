{
	"name": "sepinaco-libreria",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "libs/sepinaco-libreria/src",
	"prefix": "platform",
	"projectType": "library",
	"release": {
		"version": {
			"manifestRootsToUpdate": ["dist/{projectRoot}"],
			"currentVersionResolver": "git-tag",
			"fallbackCurrentVersionResolver": "disk"
		}
	},
	"tags": [],
	"targets": {
		"build": {
			"executor": "@nx/angular:package",
			"outputs": ["{workspaceRoot}/dist/{projectRoot}"],
			"defaultConfiguration": "production",
			"options": {
				"project": "libs/sepinaco-libreria/ng-package.json",
				"tsConfig": "libs/sepinaco-libreria/tsconfig.lib.json"
			},
			"configurations": {
				"production": {
					"tsConfig": "libs/sepinaco-libreria/tsconfig.lib.prod.json"
				},
				"development": {}
			}
		},
		"nx-release-publish": {
			"options": {
				"packageRoot": "dist/{projectRoot}"
			}
		},
		"test": {
			"executor": "@nx/vitest:test",
			"outputs": ["{options.reportsDirectory}"],
			"options": {
				"reportsDirectory": "coverage/libs/sepinaco-libreria"
			}
		},
		"lint": {
			"executor": "@nx/eslint:lint"
		}
	}
}
